# KAIROS Production Environment Configuration
# Copy this file to backend/.env or set these environment variables in your deployment dashboard (Render/Supabase/Vercel).

# 1. Admin Authentication (Set strong credentials in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# 2. Cryptographic JWT Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-long-random-secret

# 3. AI Triage Engine (Google Gemini API — automatically uses deterministic fallback if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 4. Production Database Connection (Supabase or Render PostgreSQL URI; defaults to SQLite if omitted)
# Example Supabase URI: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/kairos

# 5. Frontend URL & CORS Allowed Origins (Comma-separated for multiple domains)
FRONTEND_URL=https://kairos-frontend.vercel.app
ALLOWED_ORIGINS=https://kairos-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173
